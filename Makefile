BUILD   := build
PRG     := $(BUILD)/petty.prg
PRG128  := $(BUILD)/petty128.prg
PRG80   := $(BUILD)/petty80.prg
PRG53   := $(BUILD)/petty53.prg
PRGHI   := $(BUILD)/pettyhires.prg
PRGALL  := $(BUILD)/pettyall.prg
PORT    ?= 6464
DIAL    ?=
DIALINIT ?=
DIALDEBUG ?=
DIALASK ?=

# VICE: SwiftLink cartridge (6551 at $DE00, NMI) on RS-232 device 1, which
# is a raw TCP connection to the bridge.
VICE_FLAGS := -acia1 -acia1mode 1 -acia1base 0xDE00 -acia1irq 1 \
              -myaciadev 0 -rsdev1 127.0.0.1:$(PORT) +rsdev1ip232 -rsdev1baud 38400

.PHONY: all clean bridge theme title vice vice128 vice80 vice53 vicehires viceall run test game-check mode-check

all: $(PRG) $(PRG128) $(PRG80) $(PRG53) $(PRGHI) $(PRGALL)

# The generator writes both includes.
c64/glyphs.inc: bridge/src/glyphs.js bridge/src/font4x8.js bridge/src/font6x8.js bridge/scripts/gen-glyphs.js
	node bridge/scripts/gen-glyphs.js
c64/font4x8.inc c64/font6x8.inc: c64/glyphs.inc ;

# make DIAL=host:port builds clients that dial the bridge through a WiFi
# modem; DIALINIT=ATC makes them send that command line first;
# DIALDEBUG=1 shows the dial's
# progress on the screen; DIALASK=1 makes it ask for
# these on screen and keep them in PETTY.CFG on disk, with DIAL, DIALINIT and DIALDEBUG as the defaults. Checked as the Makefile is read: a new DIAL rewrites dialstr.inc
# and removes the objects and programs, because make 3.81 can't order
# timestamps within the same second.
DIALSTR := $(BUILD)/dialstr.inc
COMMA   := ,
$(shell mkdir -p $(BUILD) && \
  printf '; generated by make from DIAL, DIALINIT, DIALDEBUG and DIALASK\ndial_host_def: .byte %s0\ndial_init_def: .byte %s0\nDIAL_DEBUG = %s\nDIAL_ASK = %s\n' '$(if $(DIAL),"$(DIAL)"$(COMMA) )' '$(if $(DIALINIT),"$(DIALINIT)"$(COMMA) )' '$(if $(DIALDEBUG),1,0)' '$(if $(DIALASK),1,0)' > $(DIALSTR).tmp && \
  { cmp -s $(DIALSTR).tmp $(DIALSTR) && rm $(DIALSTR).tmp || { mv $(DIALSTR).tmp $(DIALSTR); rm -f $(BUILD)/*.o $(BUILD)/*.prg; }; })

# make START=c64-80 (c64, c64-hires, c64-80 or c64-53): the screen the combined client
# (pettyall.prg) starts on, until the bridge says otherwise. Checked as DIAL is.
START   ?= c64-hires
START_ID := $(if $(filter c64,$(START)),0,$(if $(filter c64-80,$(START)),2,$(if $(filter c64-hires,$(START)),3,$(if $(filter c64-53,$(START)),4,$(error START=$(START): use c64, c64-hires, c64-80 or c64-53)))))
STARTINC := $(BUILD)/start.inc
$(shell mkdir -p $(BUILD) && \
  printf '; generated by make from START\nSTART_DISPLAY = %s\n' '$(START_ID)' > $(STARTINC).tmp && \
  { cmp -s $(STARTINC).tmp $(STARTINC) && rm $(STARTINC).tmp || { mv $(STARTINC).tmp $(STARTINC); rm -f $(BUILD)/mainall.o $(PRGALL); }; })

$(BUILD)/main.o: c64/main.s c64/glyphs.inc c64/sound.inc c64/game.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/main.lst -o $@ c64/main.s

$(PRG): $(BUILD)/main.o c64/petty.cfg
	ld65 -C c64/petty.cfg -m $(BUILD)/petty.map -o $@ $(BUILD)/main.o

$(BUILD)/main128.o: c128/main.s c64/glyphs.inc c64/sound.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/main128.lst -o $@ c128/main.s

$(PRG128): $(BUILD)/main128.o c128/petty128.cfg
	ld65 -C c128/petty128.cfg -m $(BUILD)/petty128.map -o $@ $(BUILD)/main128.o

$(BUILD)/main80.o: c64/main80.s c64/font4x8.inc c64/sound.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/main80.lst -o $@ c64/main80.s

$(PRG80): $(BUILD)/main80.o c64/petty80.cfg
	ld65 -C c64/petty80.cfg -m $(BUILD)/petty80.map -o $@ $(BUILD)/main80.o

$(BUILD)/main53.o: c64/main53.s c64/font6x8.inc c64/sound.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/main53.lst -o $@ c64/main53.s

$(PRG53): $(BUILD)/main53.o c64/petty53.cfg
	ld65 -C c64/petty53.cfg -m $(BUILD)/petty53.map -o $@ $(BUILD)/main53.o

$(BUILD)/mainhires.o: c64/mainhires.s c64/glyphs.inc c64/sound.inc c64/game.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/mainhires.lst -o $@ c64/mainhires.s

$(PRGHI): $(BUILD)/mainhires.o c64/pettyhires.cfg
	ld65 -C c64/pettyhires.cfg -m $(BUILD)/pettyhires.map -o $@ $(BUILD)/mainhires.o

# The combined client: the four C64 screens above in one program.
$(BUILD)/mainall.o: c64/mainall.s c64/main.s c64/mainhires.s c64/main80.s c64/main53.s c64/glyphs.inc c64/font4x8.inc c64/font6x8.inc \
    c64/sound.inc c64/game.inc c64/move.inc c64/dial.inc c64/dialask.inc c64/restart.inc $(DIALSTR) $(STARTINC) | $(BUILD)
	ca65 -I c64 -I $(BUILD) -l $(BUILD)/mainall.lst -o $@ c64/mainall.s

$(PRGALL): $(BUILD)/mainall.o c64/pettyall.cfg
	ld65 -C c64/pettyall.cfg -m $(BUILD)/pettyall.map -o $@ $(BUILD)/mainall.o

# A standalone program, not one of the clients: plays the staircase for
# bridge/scripts/sound-calibrate.js (make build/staircase.prg).
$(BUILD)/staircase.prg: c64/staircase.s c64/staircase.cfg | $(BUILD)
	ca65 -l $(BUILD)/staircase.lst -o $(BUILD)/staircase.o c64/staircase.s
	ld65 -C c64/staircase.cfg -m $(BUILD)/staircase.map -o $@ $(BUILD)/staircase.o

$(BUILD):
	mkdir -p $@

# The start screen, with the version from bridge/package.json (or
# make title VERSION=1.2.3)
title:
	$(if $(VERSION),VERSION=$(VERSION) )node bridge/scripts/gen-title.js

bridge/node_modules:
	cd bridge && npm install

# Terminal 1: the bridge (extra args: make bridge CMD="bash")
bridge: bridge/node_modules
	node bridge/src/bridge.js --port $(PORT) $(CMD)

# Switch the running bridge's theme: make theme T=amber (or next, prev; no T: show it)
theme:
	node bridge/scripts/petty-ctl.js --port $$(($(PORT) + 1)) theme $(T)

# Terminal 2: the emulator
vice: $(PRG)
	x64sc $(VICE_FLAGS) -autostart $(PRG)

# Terminal 2, C128 in 80 columns (the VDC window)
vice128: $(PRG128)
	x128 -80col $(VICE_FLAGS) -autostart $(PRG128)

# Terminal 2, C64 with the soft 80-column bitmap screen
vice80: $(PRG80)
	x64sc $(VICE_FLAGS) -autostart $(PRG80)

# Terminal 2, C64 with the soft 53-column bitmap screen
vice53: $(PRG53)
	x64sc $(VICE_FLAGS) -autostart $(PRG53)

# Terminal 2, C64 with the 40-column hi-res bitmap screen
vicehires: $(PRGHI)
	x64sc $(VICE_FLAGS) -autostart $(PRGHI)

# Terminal 2, C64 with the combined client (the bridge switches its screen: C=+F3)
viceall: $(PRGALL)
	x64sc $(VICE_FLAGS) -autostart $(PRGALL)

test: bridge/node_modules
	cd bridge && node --test

clean:
	rm -rf $(BUILD)

# The text client's game hardware, checked in VICE (opens a window); also on the
# combined client's text and hi-res screens.
game-check: $(PRG) $(PRGHI) $(PRGALL)
	node bridge/scripts/vice-game-check.js $(PRG)
	node bridge/scripts/vice-game-check.js --hires $(PRGHI)
	node bridge/scripts/vice-game-check.js --all $(PRGALL)
	node bridge/scripts/vice-game-check.js --all --hires $(PRGALL)

# The combined client's screens against the single-screen clients', in VICE.
mode-check: $(PRG) $(PRGHI) $(PRG80) $(PRG53) $(PRGALL)
	node bridge/scripts/vice-mode-check.js $(BUILD)
